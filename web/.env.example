# Console sign-in.
#
# Both values are public by design. The auth URL is where the browser signs
# in; everything the Data API URL can reach is behind row-level security keyed
# on the signed-in person's JWT. There is no secret key anywhere — the relay
# verifies the same JWT against Neon Auth's published keys.
#
# The auth URL is a path on this origin: the Vite dev proxy (and Caddy in
# production) forwards it to NEON_AUTH_UPSTREAM, so the session cookie is
# first-party and survives browsers that block third-party cookies.
#
# Find the upstream with: neon neon-auth status / neon data-api get
VITE_NEON_AUTH_URL=/neon-auth
NEON_AUTH_UPSTREAM=https://ep-xxx.neonauth.c-6.eu-central-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-6.eu-central-1.aws.neon.tech/neondb/rest/v1
